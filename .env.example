# ═══════════════════════════════════════════════════════════════════════════
# Wholesale of Oklahoma — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────────────────────────────────

# Port for the production Express server (default: 3000)
PORT=3000

# Application URL — used for OAuth redirect URI and self-referential links.
# In development: http://localhost:3000
# In production:  https://yourdomain.com
APP_URL="http://localhost:3000"


# ──────────────────────────────────────────────────────────────────────────
# ZOHO OAUTH 2.0 CREDENTIALS
# ──────────────────────────────────────────────────────────────────────────
# HOW TO GET THESE:
#   1. Go to https://api-console.zoho.com/
#   2. Click "Add Client" → choose "Self Client" (for server-to-server)
#   3. Copy Client ID and Client Secret below
#   4. Generate a code with scope: ZohoInventory.fullaccess.all
#   5. POST that code to /api/zoho/exchange  (see SETUP.md)
#   6. The server writes ZOHO_REFRESH_TOKEN to this file automatically
# ──────────────────────────────────────────────────────────────────────────

# From Zoho API Console → your app's Client ID
ZOHO_CLIENT_ID="your_zoho_client_id_here"

# From Zoho API Console → your app's Client Secret (ROTATE REGULARLY)
ZOHO_CLIENT_SECRET="your_zoho_client_secret_here"

# Where Zoho redirects after OAuth authorization (must match API Console setting)
ZOHO_REDIRECT_URI="https://www.wholesaleofoklahoma.com/api/zoho/callback"

# Refresh token — set in server environment / Vercel secrets
ZOHO_REFRESH_TOKEN="your_zoho_refresh_token_here"

# Your Zoho Inventory Organization ID.
# Find it: Zoho Inventory → Settings → Organization Profile → Organization ID
ZOHO_ORG_ID="your_zoho_org_id_here"

# Zoho data center region. Options: com | eu | in | com.au | ca | jp
# Most US customers use "com"
ZOHO_DC="com"


# ──────────────────────────────────────────────────────────────────────────
# SECURITY & ADMINISTRATION
# ──────────────────────────────────────────────────────────────────────────

# HMAC session signing secret (64+ random hex/base64 characters). Crucial for production cookies.
SESSION_SECRET="generate_a_strong_64_character_session_signing_secret_here"

# Strong random secret (32+ chars) used to authorize legacy admin API actions & settings changes
ADMIN_SECRET_KEY="generate_a_random_32_char_secret_here"

# Production Administrator Notification & Account Email
ADMIN_NOTIFICATION_EMAIL="order2wholesaleofoklahoma@gmail.com"

# Optional: Initial admin password for automated cold-boot provisioning.
# If provided, the system initializes order2wholesaleofoklahoma@gmail.com with this password if no password exists.
# Alternatively, use "Forgot Password" on the admin login page or scripts/bootstrap_admin.ts.
ADMIN_PASSWORD=""

# Webhook secret to validate incoming Zoho webhook pushes
ZOHO_WEBHOOK_SECRET="generate_a_random_32_char_webhook_secret_here"

# Canonical Production URL (used in email links, password resets, and account activation)
SITE_URL="https://www.wholesaleofoklahoma.com"


# ──────────────────────────────────────────────────────────────────────────
# EMAIL DISPATCH SYSTEM (Required for Password Resets & Customer Approval Emails)
# Configure at least ONE of the following options in Vercel / Production:
# ──────────────────────────────────────────────────────────────────────────

# --- Option A: Direct Gmail (Recommended for guaranteed inbox delivery to Gmail) ---
# Generate a Google App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER="order2wholesaleofoklahoma@gmail.com"
GMAIL_APP_PASSWORD=""

# --- Option B: Custom / Corporate SMTP ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="order2wholesaleofoklahoma@gmail.com"
SMTP_PASS=""
SMTP_SECURE="true"
SMTP_FROM="Wholesale of Oklahoma <orders@wholesaleofoklahoma.com>"

# --- Option C: Resend API (Transactional Email Service) ---
# Sign up at https://resend.com and verify wholesaleofoklahoma.com domain
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Wholesale of Oklahoma <orders@wholesaleofoklahoma.com>"

# --- Option D: SendGrid API ---
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="orders@wholesaleofoklahoma.com"


# ──────────────────────────────────────────────────────────────────────────
# ZOHO INVENTORY BEHAVIOR
# ──────────────────────────────────────────────────────────────────────────

# Items with available_stock <= this number show "Low Stock" badge
ZOHO_LOW_STOCK_THRESHOLD=15

# How long to cache Zoho API responses (seconds). Default: 60
# Lower = fresher data, higher = fewer API calls
ZOHO_CACHE_TTL_SECONDS=60

# Max pages to fetch from Zoho per sync (200 items/page). Default: 10 = 2000 items max
ZOHO_MAX_PAGES=10


# ──────────────────────────────────────────────────────────────────────────
# AI ASSISTANT (Mango Chat)
# ──────────────────────────────────────────────────────────────────────────

# Server-side Gemini API key (for backend proxy — never exposed to client)
GEMINI_API_KEY="your_gemini_api_key_here"
